<Window x:Class="CarManagement.AddPartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Part" Height="450" Width="400">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <StackPanel>

                <TextBlock Text="SKU (article)" />
                <TextBox x:Name="SkuBox" Margin="0,5"/>

                <Button Content="Get from InterCars" Margin="0,5" Click="Fetch_Click"/>

                <TextBlock Text="Name" />
                <TextBox x:Name="NameBox" Margin="0,5"/>

                <TextBlock Text="Brand" />
                <TextBox x:Name="BrandBox" Margin="0,5"/>

                <TextBlock Text="Price" />
                <TextBox x:Name="PriceBox" Margin="0,5"/>

                <TextBlock Text="URL" />
                <TextBox x:Name="UrlBox" Margin="0,5"/>

                <Button Content="Import from Trodo" Click="ImportFromTrodo_Click" Margin="5"/>

                <Button Content="Save" Margin="0,10,0,0" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
