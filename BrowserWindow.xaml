<Window x:Class="CarManagement.Views.BrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Browser" Height="600" Width="900">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <!-- Панель кнопок -->
            <RowDefinition Height="*"/>
            <!-- WebView2 -->
        </Grid.RowDefinitions>

        <!-- Панель кнопок -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="10">
            <Button Content="Import" Width="120" Margin="5" Click="Import_Click"/>
            <Button Content="Добавить в список" Width="150" Margin="5" Click="AddToList_Click"/>
            <Button Content="Import Cart" Width="120" Margin="5" Click="ImportCart_Click"/>
            <Button Content="Import Cart" Width="120" Margin="5" Click="ImportCart_Click"/>

        </StackPanel>



        <wv2:WebView2 x:Name="Browser" Grid.Row="1"/>
    </Grid>
</Window>
