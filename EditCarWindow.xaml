<Window x:Class="CarManagement.EditCarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Car" Height="420" Width="400">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>

            <TextBox x:Name="NumberPlateBox" Margin="0,5" Tag="Number Plate"/>
            <TextBox x:Name="BrandBox" Margin="0,5" Tag="Brand"/>
            <TextBox x:Name="ModelBox" Margin="0,5" Tag="Model"/>
            <TextBox x:Name="YearBox" Margin="0,5" Tag="Year"/>
            <TextBox x:Name="EngineTypeBox" Margin="0,5" Tag="Engine Type"/>
            <TextBox x:Name="EngineVolumeBox" Margin="0,5" Tag="Engine Volume (L)"/>
            <TextBox x:Name="KilowattsBox" Margin="0,5" Tag="Kilowatts"/>

        </StackPanel>

        <Button Grid.Row="1"
                Content="Save Changes"
                Height="40"
                Margin="0,10,0,0"
                Click="Save_Click"/>
    </Grid>
</Window>
